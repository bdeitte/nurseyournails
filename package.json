{
  "name": "nurseyournails",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "serve": "npx serve public",
    "build": "node scripts/build.mjs",
    "format": "prettier --write \"src/**/*.{html,css}\"",
    "optimize": "node scripts/optimize-images.mjs",
    "refresh-gallery": "node scripts/refresh-gallery.mjs",
    "refresh": "npm run lint && npm run format && npm run refresh-gallery",
    "lighthouse": "lighthouse",
    "lint": "eslint --cache --cache-location .eslintcache \"src/assets/css/**/*.css\"",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@eslint/css": "^1.3.0",
    "browserslist": "^4.28.2",
    "eslint": "^10.5.0",
    "html-minifier-terser": "^7.2.0",
    "lighthouse": "^13.4.1",
    "lightningcss": "^1.32.0",
    "prettier": "^3.8.4",
    "sharp": "^0.35.3",
    "wrangler": "^4.103.0"
  }
}
